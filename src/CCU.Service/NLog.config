<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogToConsole="false">

  <!-- NLog 自身故障时写到 internal log，避免再次出现"静默零输出"无从排查 -->
  <internalLogFile>${environment:variable=ProgramData}\CCU_Alternative\nlog-internal.log</internalLogFile>

  <variable name="logDirectory" value="${environment:variable=ProgramData}\CCU_Alternative"/>

  <targets>
    <!-- 简单可靠的同步文件目标：keepFileOpen=false 保证多进程/多账户都能写 -->
    <target name="file_info" xsi:type="File"
            fileName="${logDirectory}/Info/${shortdate}.txt"
            keepFileOpen="false"
            layout="${date:format=yyyy\-MM\-dd HH\:mm\:ss.fff}| ${level}| ${logger}| ${message} ${exception:format=tostring}"/>

    <target name="file_error" xsi:type="File"
            fileName="${logDirectory}/Error/${shortdate}.txt"
            keepFileOpen="false"
            layout="${date:format=yyyy\-MM\-dd HH\:mm\:ss.fff}| ${level}| ${logger}| ${message} ${exception:format=tostring}"/>

    <target name="console" xsi:type="Console"
            layout="${date:format=HH\:mm\:ss}| ${level:padding=5}| ${message}"/>
  </targets>

  <rules>
    <logger name="*" level="Error" writeTo="file_error"/>
    <logger name="*" minlevel="Info" writeTo="file_info"/>
    <logger name="*" minlevel="Info" writeTo="console"/>
  </rules>
</nlog>
