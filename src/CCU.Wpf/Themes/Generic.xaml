<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CCU.Wpf.Converters"
                    xmlns:ctrl="clr-namespace:CCU.Wpf.Controls"
                    xmlns:vm="clr-namespace:CCU.Wpf.ViewModels">

    <!-- ═══════════════════════════════════════════════
         FanCurvePanel 默认样式
         Thumb 事件通过 Style EventSetter 连接
         ═══════════════════════════════════════════════ -->
    <Style TargetType="conv:FanCurvePanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="conv:FanCurvePanel">
                    <Border Padding="12" CornerRadius="10"
                            Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Canvas Width="360" Height="180" Background="#05FFFFFF" ClipToBounds="True">
                                <Line X1="0" Y1="45" X2="360" Y2="45" Stroke="#0DFFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="90" X2="360" Y2="90" Stroke="#0DFFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="135" X2="360" Y2="135" Stroke="#0DFFFFFF" StrokeThickness="1" />

                                <Polygon x:Name="PART_Fill" Fill="#2200D4AA" />
                                <Polyline x:Name="PART_Line" Stroke="#FF00D4AA" StrokeThickness="2"
                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round" />

                                <ItemsControl x:Name="PART_Nodes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FanPoint}">
                                            <Thumb Cursor="Hand" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>

                                <TextBlock Canvas.Left="2" Canvas.Top="166" Text="0°C" FontSize="9" Foreground="#FF475569" />
                                <TextBlock Canvas.Left="330" Canvas.Top="166" Text="100°C" FontSize="9" Foreground="#FF475569" />
                                <TextBlock Canvas.Left="2" Canvas.Top="2" Text="100%" FontSize="9" Foreground="#FF475569" />
                            </Canvas>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="180">
                                <TextBlock Text="控制节点" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                                <ScrollViewer MaxHeight="140" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{TemplateBinding CurveData}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FanPoint}">
                                                <Border Padding="8,5" Margin="0,0,0,4"
                                                        Background="#0DFFFFFF" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="🌡" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Text="{Binding Temperature, UpdateSourceTrigger=LostFocus}"
                                                                 Width="36" FontSize="12" FontFamily="{StaticResource FontMono}"
                                                                 Foreground="{StaticResource BrushAccentPrimary}"
                                                                 Background="Transparent" BorderThickness="0"
                                                                 VerticalAlignment="Center" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="°C →" FontSize="11"
                                                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="4,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Duty, StringFormat='{}{0}%'}"
                                                                   FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource FontMono}"
                                                                   Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" Width="36" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Content="+ 添加" Style="{StaticResource GhostButton}" FontSize="11"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb 节点样式 (拖拽手柄) — 与 CustomControls 统一外观 -->
    <Style TargetType="Thumb" x:Key="FanNodeThumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="16" Height="16" Fill="#FF00D4AA">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF00D4AA" BlurRadius="6" ShadowDepth="0" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="#FF0B0E14" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
