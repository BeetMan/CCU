<UserControl x:Class="CCU.Wpf.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CCU.Wpf.Converters">

    <UserControl.Resources>
        <conv:IntEqualityConverter x:Key="IntEq" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="显示设置" Style="{StaticResource TextHeading}" />
        <TextBlock Text="色彩预设与显示调校" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- 色彩预设 -->
        <TextBlock Text="色彩预设" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="预设模式" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Right"
                          Background="{StaticResource BrushBgTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorderCard}"
                          FontSize="13"
                          SelectedIndex="{Binding Profile}">
                    <ComboBoxItem Content="鲜艳 — 高饱和" />
                    <ComboBoxItem Content="上网 — 自然色" />
                    <ComboBoxItem Content="视频 — 暖色调" />
                    <ComboBoxItem Content="低蓝光 — 护眼" />
                    <ComboBoxItem Content="影院 — D65校准" />
                    <ComboBoxItem Content="照片 — sRGB" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- 微调 -->
        <TextBlock Text="微调" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="亮度" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Brightness, StringFormat='{}{0:F0}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100"
                            Value="{Binding Brightness, Mode=TwoWay}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="色温" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding ColorTemp, StringFormat='{}{0:F0}K'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="5000" Maximum="9300"
                            Value="{Binding ColorTemp, Mode=TwoWay}"
                            TickFrequency="100" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="饱和度" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Saturation, StringFormat='{}{0:F1}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0.5" Maximum="2.5"
                            Value="{Binding Saturation, Mode=TwoWay}"
                            TickFrequency="0.1" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ICC -->
        <TextBlock Text="ICC 管理" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="当前 ICC" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock Text="BOE0D55_JJ00GF..." FontSize="13" FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="导入 ICC..."
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
