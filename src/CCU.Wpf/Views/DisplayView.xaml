<UserControl x:Class="CCU.Wpf.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CCU.Wpf.Converters">

    <StackPanel>
        <TextBlock Text="显示设置" Style="{StaticResource TextHeading}" />
        <TextBlock Text="亮度与刷新率 (标准系统接口)" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- 亮度 -->
        <TextBlock Text="屏幕亮度" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <StackPanel>
                <Grid>
                    <TextBlock Text="内建显示器背光" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding Brightness, StringFormat='{}{0:F0}%'}"
                               FontSize="14" FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                </Grid>
                <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100"
                        Value="{Binding Brightness, Mode=TwoWay}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- 刷新率 -->
        <TextBlock Text="刷新率" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="当前分辨率下可用刷新率" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                </StackPanel>
                <ComboBox ItemsSource="{Binding RefreshRates}"
                          SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}"
                          Width="140" HorizontalAlignment="Right"
                          Background="{StaticResource BrushBgTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorderCard}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource GlassCard}" Padding="16">
            <StackPanel>
                <TextBlock Text="· 切换异常时 Windows 会在 15 秒内自动还原" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}" />
                <TextBlock Text="· 色彩预设/ICC 管理依赖原厂专有协议，将在后续版本评估" FontSize="12" Margin="0,4,0,0"
                           Foreground="{StaticResource BrushTextMuted}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
