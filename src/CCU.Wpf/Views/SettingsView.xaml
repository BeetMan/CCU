<UserControl x:Class="CCU.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="系统设置" Style="{StaticResource TextHeading}" />
        <TextBlock Text="配置应用行为与偏好" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- 常规设置 -->
        <TextBlock Text="常规" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="开机自启" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="系统启动时自动运行智控中心服务" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStart, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="最小化到托盘" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="关闭窗口时隐藏到系统托盘" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="显示 OSD 提示" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="切换性能模式时屏幕显示提示" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OsdEnabled, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 语言 / 主题 -->
        <TextBlock Text="界面" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="语言" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="{Binding Language, StringFormat='当前: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <ComboBox Width="120" HorizontalAlignment="Right"
                          Background="{StaticResource BrushBgTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorderCard}">
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="English (US)" />
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="主题" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="当前: Obsidian Neon" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <ComboBox SelectedIndex="0" Width="120" HorizontalAlignment="Right"
                          Background="{StaticResource BrushBgTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorderCard}">
                    <ComboBoxItem Content="暗黑霓虹" />
                    <ComboBoxItem Content="明亮模式" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- 关于 -->
        <TextBlock Text="关于" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <StackPanel>
                <TextBlock Text="智控中心 CCU Alternative" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock Text="版本 0.1.0 — 开源笔记本控制中心" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                <TextBlock Text="基于 WPF .NET 8 | LibreHardwareMonitor | HidSharp" FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
