<UserControl x:Class="CCU.Wpf.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CCU.Wpf.Controls"
             xmlns:conv="clr-namespace:CCU.Wpf.Converters">
    <UserControl.Resources>
        <conv:TemperatureToColorConverter x:Key="TempColor" />
        <conv:MultiParamConverter x:Key="IsMode" />
        <conv:OcToggleConverter x:Key="OcToggleParam" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="性能模式" Style="{StaticResource TextHeading}" />
        <TextBlock Text="切换功耗与散热配置" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- 4 模式卡片 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 办公 -->
            <Button Grid.Column="0" Margin="0,0,8,0"
                    Command="{Binding DataContext.SetPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="office" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="card" Padding="20,20" CornerRadius="12"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="28" />
                                <TextBlock Text="办公" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4" />
                                <TextBlock Text="静音风扇 · 续航优先" FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.ActivePerformanceMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BrushAccentPrimary}" />
                                <Setter TargetName="card" Property="Background" Value="#2200D4AA" />
                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 游戏 -->
            <Button Grid.Column="1" Margin="0,0,8,0"
                    Command="{Binding DataContext.SetPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="gaming" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="card" Padding="20,20" CornerRadius="12"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="🎮" FontSize="28" />
                                <TextBlock Text="游戏" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FF00D4AA" Margin="0,12,0,4" />
                                <TextBlock Text="均衡性能 · 智能散热" FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.ActivePerformanceMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BrushAccentPrimary}" />
                                <Setter TargetName="card" Property="Background" Value="#2200D4AA" />
                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 狂暴 -->
            <Button Grid.Column="2" Margin="0,0,8,0"
                    Command="{Binding DataContext.SetPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="turbo" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="card" Padding="20,20" CornerRadius="12"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="🔥" FontSize="28" />
                                <TextBlock Text="狂暴" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FFF97316" Margin="0,12,0,4" />
                                <TextBlock Text="满血性能 · 风扇全速" FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.ActivePerformanceMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BrushAccentTurbo}" />
                                <Setter TargetName="card" Property="Background" Value="#22F97316" />
                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 自定义 -->
            <Button Grid.Column="3" Margin="0,0,0,0"
                    Command="{Binding DataContext.SetPerformanceModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="custom" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="card" Padding="20,20" CornerRadius="12"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="⚡" FontSize="28" />
                                <TextBlock Text="自定义" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FF0EA5E9" Margin="0,12,0,4" />
                                <TextBlock Text="手动调校每个参数" FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.ActivePerformanceMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BrushAccentSecondary}" />
                                <Setter TargetName="card" Property="Background" Value="#220EA5E9" />
                                <Setter TargetName="card" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 当前模式指示 + 狂暴细分 + 自定义 Profile -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12,6" CornerRadius="8" Background="#2200D4AA" VerticalAlignment="Center">
                <TextBlock Text="{Binding DataContext.ModeLabel, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=--}"
                           FontWeight="SemiBold" Foreground="{StaticResource BrushAccentPrimary}" />
            </Border>
            <TextBlock Grid.Column="1" Text="切换中，正在等待原厂确认..." FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       Visibility="{Binding DataContext.ModeCommandInProgress, RelativeSource={RelativeSource AncestorType=Window}}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 狂暴细分（仅狂暴模式有效） -->
                <Button Margin="4,0,0,0" Padding="14,6" Cursor="Hand"
                        Command="{Binding DataContext.SetTurboDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="silent"
                        Content="狂暴 · 静技" />
                <Button Margin="4,0,0,0" Padding="14,6" Cursor="Hand"
                        Command="{Binding DataContext.SetTurboDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="extreme"
                        Content="狂暴 · 极速" />
            </StackPanel>
        </Grid>

        <!-- 自定义 Profile 芯片 -->
        <ItemsControl ItemsSource="{Binding CustomProfiles}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,8,0" Padding="14,6" Cursor="Hand"
                            Command="{Binding DataContext.SetCustomProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Slot, Mode=OneTime}"
                            BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="chip" Padding="{TemplateBinding Padding}" CornerRadius="16"
                                        Background="#1A0EA5E9" BorderBrush="#330EA5E9" BorderThickness="1">
                                    <TextBlock Text="{Binding Label}" Foreground="#FF0EA5E9" FontWeight="SemiBold" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="chip" Property="Background" Value="#330EA5E9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 强冷 / GPU OC 快捷开关 -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,6,0" Padding="16,10" Cursor="Hand"
                    Command="{Binding DataContext.ToggleFanBoostCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="boost" Padding="{TemplateBinding Padding}" CornerRadius="10"
                                Background="#1AF97316" BorderBrush="#33F97316" BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❄" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="一键强冷" Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="#FFF97316" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DataContext.FanBoostOn, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='  {0}', FallbackValue=''}"
                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="boost" Property="Background" Value="#2AF97316" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="16,10" Cursor="Hand"
                    Command="{Binding DataContext.SetTurboOcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding DataContext.GpuOcOffset, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource OcToggleParam}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="oc" Padding="{TemplateBinding Padding}" CornerRadius="10"
                                Background="#1A00D4AA" BorderBrush="#3300D4AA" BorderThickness="1.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="GPU OC +150 MHz (仅狂暴)" Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DataContext.GpuOcOffset, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='  +{0} MHz', FallbackValue=''}"
                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="oc" Property="Background" Value="#2A00D4AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 硬件状态 -->
        <TextBlock Text="实时状态" Style="{StaticResource SectionHeader}" />
        <Grid Height="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ctrl:MetricDisplay Grid.Column="0"
                Value="{Binding DataContext.CpuTemp, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="°C" SubLabel="CPU 温度" />

            <ctrl:MetricDisplay Grid.Column="1"
                Value="{Binding DataContext.GpuTemp, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="°C" SubLabel="GPU 温度" />

            <ctrl:MetricDisplay Grid.Column="2"
                Value="{Binding DataContext.CpuUsage, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="%" SubLabel="CPU 负载" AccentColor="{StaticResource BrushAccentSecondary}" />

            <ctrl:MetricDisplay Grid.Column="3"
                Value="{Binding DataContext.GpuUsage, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="%" SubLabel="GPU 负载" />

            <ctrl:MetricDisplay Grid.Column="4"
                Value="{Binding DataContext.CpuFanSpeed, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="RPM" SubLabel="CPU 风扇" AccentColor="{StaticResource BrushAccentPrimary}" />

            <ctrl:MetricDisplay Grid.Column="5"
                Value="{Binding DataContext.BatteryLevel, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0:F0}', FallbackValue='--'}"
                Unit="%" SubLabel="电池电量" AccentColor="{StaticResource BrushAccentWarn}" />
        </Grid>
    </StackPanel>
</UserControl>
