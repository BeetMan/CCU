<UserControl x:Class="CCU.Wpf.Views.DemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CCU.Wpf.Controls">

    <ScrollViewer>
        <StackPanel>

            <!-- ═══ 标题 ═══ -->
            <TextBlock Text="设计展示" Style="{StaticResource TextHeading}" />
            <TextBlock Text="Obsidian Neon — 所有控件与主题色一览" Style="{StaticResource TextSubtitle}" Margin="0,4,0,28" />

            <!-- ═══════════════════════════ 色彩板 ═══════════════════════════ -->
            <TextBlock Text="🎨 色彩板" Style="{StaticResource SectionHeader}" />

            <WrapPanel Margin="0,0,0,16">
                <!-- Accent Primary -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushAccentPrimary}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="AccentPrimary" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#00D4AA" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>

                <!-- Accent Secondary -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushAccentSecondary}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="AccentSecondary" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#0EA5E9" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>

                <!-- Accent Warn -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushAccentWarn}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="AccentWarn" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#F59E0B" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>

                <!-- Accent Danger -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushAccentDanger}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="AccentDanger" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#EF4444" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>

                <!-- Accent Turbo -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushAccentTurbo}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="AccentTurbo" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#F97316" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>

                <!-- BgPrimary -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushBgPrimary}" BorderBrush="{StaticResource BrushBorderCard}" BorderThickness="1" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="BgPrimary" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="#0B0E14" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- BgSecondary -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushBgSecondary}" BorderBrush="{StaticResource BrushBorderCard}" BorderThickness="1" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="BgSecondary" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="#11151E" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- BgTertiary -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource BrushBgTertiary}" BorderBrush="{StaticResource BrushBorderCard}" BorderThickness="1" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="BgTertiary" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="#181C28" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- Gradient Accent -->
                <Border Width="180" Height="90" CornerRadius="8" Margin="0,0,10,10"
                        Background="{StaticResource GradientAccent}" Padding="12">
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="GradientAccent" FontSize="11" FontWeight="SemiBold" Foreground="#FF0B0E14" />
                        <TextBlock Text="#00D4AA → #0EA5E9" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="#FF0B0E14" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- ═══════════════════════════ 字体层级 ═══════════════════════════ -->
            <TextBlock Text="🔤 字体层级" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource GlassCard}" Padding="20">
                <StackPanel>
                    <TextBlock Text="TextDisplayLarge (28px Semibold)" Style="{StaticResource TextDisplayLarge}" />
                    <TextBlock Text="TextHeading (18px Semibold)" Style="{StaticResource TextHeading}" Margin="0,8,0,0" />
                    <TextBlock Text="TextSubtitle (13px)" Style="{StaticResource TextSubtitle}" Margin="0,8,0,0" />
                    <TextBlock Text="TextBody (14px) — 正文段落，用于描述性文字和设置说明" Style="{StaticResource TextBody}" Margin="0,8,0,0" />
                    <TextBlock Text="TextCaption (11px Muted) — 辅助信息" Style="{StaticResource TextCaption}" Margin="0,8,0,0" />
                    <TextBlock Text="TextMono (13px Mono) — 数据读数 42.5°C" Style="{StaticResource TextMono}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════ 控件陈列 ═══════════════════════════ -->
            <TextBlock Text="🎛 控件" Style="{StaticResource SectionHeader}" />

            <!-- ModeChip -->
            <TextBlock Text="ModeChip — 性能模式标签" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ctrl:ModeChip Label="办公" ColorAccent="{StaticResource BrushTextSecondary}" />
                <ctrl:ModeChip Label="游戏" ColorAccent="{StaticResource BrushAccentPrimary}" />
                <ctrl:ModeChip Label="狂暴" ColorAccent="{StaticResource BrushAccentTurbo}" />
                <ctrl:ModeChip Label="自定义" ColorAccent="{StaticResource BrushAccentSecondary}" />
            </StackPanel>

            <!-- Buttons -->
            <TextBlock Text="Buttons — 按钮" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource AccentButton}" Content="主要操作" Margin="0,0,10,0" />
                <Button Style="{StaticResource GhostButton}" Content="次要操作" Margin="0,0,10,0" />
                <Button Style="{StaticResource IconButton}" Content="✕" Margin="0,0,10,0" />
            </StackPanel>

            <!-- ToggleSwitch -->
            <TextBlock Text="ToggleSwitch — 开关" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True" Margin="0,0,12,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="False" />
            </StackPanel>

            <!-- NeonSlider -->
            <TextBlock Text="NeonSlider — 滑块" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,16" Width="400">
                <StackPanel>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100" Value="65" />
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100" Value="30" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- EffectChip -->
            <TextBlock Text="EffectChip — 灯效选择" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,16">
                <ctrl:EffectChip Label="关" Highlight="{StaticResource BrushTextMuted}" />
                <ctrl:EffectChip Label="静态" Highlight="{StaticResource BrushAccentPrimary}" />
                <ctrl:EffectChip Label="呼吸" Highlight="{StaticResource BrushAccentSecondary}" />
                <ctrl:EffectChip Label="波浪" Highlight="{StaticResource BrushAccentSecondary}" />
                <ctrl:EffectChip Label="彩虹" Highlight="{StaticResource BrushAccentPrimary}" IsActive="True" />
                <ctrl:EffectChip Label="音乐联动" Highlight="{StaticResource BrushAccentWarn}" />
                <ctrl:EffectChip Label="游戏联动" Highlight="{StaticResource BrushAccentWarn}" />
            </WrapPanel>

            <!-- MetricDisplay -->
            <TextBlock Text="MetricDisplay — 指标卡片" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ctrl:MetricDisplay Value="58" Unit="°C" SubLabel="CPU 温度"
                                    AccentColor="{StaticResource BrushAccentPrimary}" Margin="0,0,10,0" />
                <ctrl:MetricDisplay Value="24" Unit="%" SubLabel="CPU 负载"
                                    AccentColor="{StaticResource BrushAccentSecondary}" Margin="0,0,10,0" />
                <ctrl:MetricDisplay Value="3200" Unit="RPM" SubLabel="主风扇"
                                    AccentColor="{StaticResource BrushAccentPrimary}" />
            </StackPanel>

            <!-- NavItem -->
            <TextBlock Text="NavItem — 导航项" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <Border Style="{StaticResource GlassCard}" Padding="8" Width="220" Margin="0,0,0,16">
                <StackPanel>
                    <ctrl:NavItem Icon="⚡" Label="性能模式 (激活)" Active="True" />
                    <ctrl:NavItem Icon="🎮" Label="GPU 设置" />
                    <ctrl:NavItem Icon="🌀" Label="风扇控制" />
                </StackPanel>
            </Border>

            <!-- GlassCard -->
            <TextBlock Text="GlassCard — 玻璃卡片" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="这是一个玻璃拟态卡片" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="GlassCard = Background #1AFFFFFF + Border #22FFFFFF + Radius 10"
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
