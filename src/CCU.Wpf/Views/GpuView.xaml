<UserControl x:Class="CCU.Wpf.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CCU.Wpf.Converters">

    <UserControl.Resources>
        <conv:IntEqualityConverter x:Key="IntEq" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="GPU 设置" Style="{StaticResource TextHeading}" />
        <TextBlock Text="显卡模式切换与性能调校" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- GPU 模式 — RadioButton 绑定到 GpuViewModel.GpuMode -->
        <TextBlock Text="显卡模式" Style="{StaticResource SectionHeader}" />

        <StackPanel>
            <!-- iGPU only -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <RadioButton GroupName="GpuMode" IsChecked="{Binding GpuMode, ConverterParameter=0, Converter={StaticResource IntEq}, Mode=TwoWay}"
                                 VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="仅集成显卡" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="禁用独显，最大化续航" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="需要重启" FontSize="11" Foreground="#FFF97316"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- dGPU only -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <RadioButton GroupName="GpuMode" IsChecked="{Binding GpuMode, ConverterParameter=1, Converter={StaticResource IntEq}, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="仅独立显卡" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="绕过 Optimus，直连独显性能" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="需要重启" FontSize="11" Foreground="#FFF97316"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- Hybrid Optimus -->
            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <RadioButton GroupName="GpuMode" IsChecked="{Binding GpuMode, ConverterParameter=2, Converter={StaticResource IntEq}, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="Optimus 混合模式" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                        <TextBlock Text="自动切换集显/独显，平衡性能与续航" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HotSwap -->
            <Border Style="{StaticResource GlassCard}" Padding="16">
                <Grid>
                    <RadioButton GroupName="GpuMode" IsChecked="{Binding GpuMode, ConverterParameter=3, Converter={StaticResource IntEq}, Mode=TwoWay}"
                                 VerticalAlignment="Center" />
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="Advanced Optimus" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="热切换独显，无需重启" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 性能调校 -->
        <TextBlock Text="性能调校" Style="{StaticResource SectionHeader}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="核心频率偏移" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid Margin="0,8,0,0">
                        <Slider Style="{StaticResource NeonSlider}" Minimum="-200" Maximum="300"
                                Value="{Binding CoreOffset, Mode=TwoWay}"
                                TickFrequency="10" IsSnapToTickEnabled="True" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding CoreOffset, StringFormat='{}{0:F0} MHz'}"
                                   FontSize="12" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="显存频率偏移" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid Margin="0,8,0,0">
                        <Slider Style="{StaticResource NeonSlider}" Minimum="-200" Maximum="1000"
                                Value="{Binding MemOffset, Mode=TwoWay}" TickFrequency="50" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding MemOffset, StringFormat='{}{0:F0} MHz'}"
                                   FontSize="12" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentSecondary}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="温度目标" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Grid Margin="0,8,0,0">
                        <Slider Style="{StaticResource NeonSlider}" Minimum="75" Maximum="92"
                                Value="{Binding ThermalTarget, Mode=TwoWay}" TickFrequency="1" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding ThermalTarget, StringFormat='{}{0:F0}°C'}"
                                   FontSize="12" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentWarn}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- WhisperMode 2.0 -->
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,16,0,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="WhisperMode 2.0" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="NVIDIA 静音游戏模式，限制帧率降低噪音" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WhisperMode, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
