<UserControl x:Class="CCU.Wpf.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="设备开关" Style="{StaticResource TextHeading}" />
        <TextBlock Text="管理笔记本硬件设备启用状态" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <!-- 每个 ToggleSwitch 绑定到 DeviceViewModel 的属性 + RelayCommand -->

        <!-- 摄像头 -->
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📷" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="摄像头" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="内置摄像头设备" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Webcam, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 独立显卡 -->
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎮" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="独立显卡" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="NVIDIA GeForce 显卡设备" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Dgpu, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- AMD Audio CoProcessor -->
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔊" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="AMD Audio CoProcessor" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="AMD 音频协处理器，省电可禁用" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding AmdAcp, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 蓝牙 -->
        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔵" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="蓝牙" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="无线蓝牙通信设备" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Bluetooth, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 飞行模式 -->
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✈️" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="飞行模式" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="一键关闭所有无线信号" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding AirplaneMode, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
