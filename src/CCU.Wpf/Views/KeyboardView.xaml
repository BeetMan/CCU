<UserControl x:Class="CCU.Wpf.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CCU.Wpf.Controls"
             xmlns:conv="clr-namespace:CCU.Wpf.Converters"
             xmlns:vm="clr-namespace:CCU.Wpf.ViewModels">

    <UserControl.Resources>
        <conv:MultiParamConverter x:Key="IsMode" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="键盘 RGB" Style="{StaticResource TextHeading}" />
        <TextBlock Text="原厂 MQTT 灯效协议 · 22 种效果" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <TextBlock Text="灯效" Style="{StaticResource SectionHeader}" />
        <WrapPanel>
            <ctrl:EffectChip Label="关" Highlight="{StaticResource BrushTextMuted}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter=''}"
                             Command="{Binding SetEffectCommand}" CommandParameter="" />
            <ctrl:EffectChip Label="静态" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Single'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Single" />
            <ctrl:EffectChip Label="呼吸" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Breathing'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Breathing" />
            <ctrl:EffectChip Label="波浪" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Wave'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Wave" />
            <ctrl:EffectChip Label="彩色波浪" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='ColorfulWave'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="ColorfulWave" />
            <ctrl:EffectChip Label="彩虹" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Rainbow'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Rainbow" />
            <ctrl:EffectChip Label="响应" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Reactive'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Reactive" />
            <ctrl:EffectChip Label="涟漪" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Ripple'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Ripple" />
            <ctrl:EffectChip Label="雨滴" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Raindrop'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Raindrop" />
            <ctrl:EffectChip Label="跑马灯" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Marquee'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Marquee" />
            <ctrl:EffectChip Label="冲击" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Impact'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Impact" />
            <ctrl:EffectChip Label="火花" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Spark'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Spark" />
            <ctrl:EffectChip Label="极光" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Aurora'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Aurora" />
            <ctrl:EffectChip Label="音乐联动" Highlight="{StaticResource BrushAccentWarn}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Music'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Music" />
            <ctrl:EffectChip Label="游戏联动" Highlight="{StaticResource BrushAccentWarn}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Gaming'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Gaming" />
            <ctrl:EffectChip Label="闪烁" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Flash'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Flash" />
            <ctrl:EffectChip Label="混合" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Mix'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Mix" />
            <ctrl:EffectChip Label="霓虹闪烁" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Twinkling'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Twinkling" />
            <ctrl:EffectChip Label="黎明" Highlight="{StaticResource BrushAccentWarn}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Dawn'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Dawn" />
            <ctrl:EffectChip Label="正弦" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Sine'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Sine" />
            <ctrl:EffectChip Label="交错" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Interlace'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Interlace" />
            <ctrl:EffectChip Label="对角" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding EffectName, Converter={StaticResource IsMode}, ConverterParameter='Diagonal'}"
                             Command="{Binding SetEffectCommand}" CommandParameter="Diagonal" />
        </WrapPanel>

        <TextBlock Text="参数" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="速度" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Speed, StringFormat='{}{0}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="1" Maximum="5"
                            Value="{Binding Speed, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="快" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="慢" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="亮度 (原厂 4 级)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Brightness, StringFormat='{}{0}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="4"
                            Value="{Binding Brightness, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="关" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="最亮" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="颜色" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="基色" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" />
                <Border Width="32" Height="32" CornerRadius="16" Margin="16,0,12,0"
                        Background="#FF00D4AA">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentPrimary}" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                    </Border.Effect>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="R" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ColorR, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,8,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                    <TextBlock Text="G" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ColorG, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,8,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                    <TextBlock Text="B" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ColorB, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,0,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Logo 灯" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="  (HidLightbar_Logo · 跟随键盘同色)" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LightbarEnabled, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
