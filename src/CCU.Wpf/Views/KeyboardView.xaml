<UserControl x:Class="CCU.Wpf.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:CCU.Wpf.Controls"
             xmlns:vm="clr-namespace:CCU.Wpf.ViewModels">

    <StackPanel>
        <TextBlock Text="键盘 RGB" Style="{StaticResource TextHeading}" />
        <TextBlock Text="自定义键盘灯效与亮度" Style="{StaticResource TextSubtitle}" Margin="0,4,0,24" />

        <TextBlock Text="灯效" Style="{StaticResource SectionHeader}" />
        <WrapPanel>
            <ctrl:EffectChip Label="关" Highlight="{StaticResource BrushTextMuted}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=0}"
                             Command="{Binding SetEffectCommand}" CommandParameter="0" />
            <ctrl:EffectChip Label="静态" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=1}"
                             Command="{Binding SetEffectCommand}" CommandParameter="1" />
            <ctrl:EffectChip Label="呼吸" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=2}"
                             Command="{Binding SetEffectCommand}" CommandParameter="2" />
            <ctrl:EffectChip Label="波浪" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=3}"
                             Command="{Binding SetEffectCommand}" CommandParameter="3" />
            <ctrl:EffectChip Label="彩虹" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=5}"
                             Command="{Binding SetEffectCommand}" CommandParameter="5" />
            <ctrl:EffectChip Label="响应" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=4}"
                             Command="{Binding SetEffectCommand}" CommandParameter="4" />
            <ctrl:EffectChip Label="涟漪" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=6}"
                             Command="{Binding SetEffectCommand}" CommandParameter="6" />
            <ctrl:EffectChip Label="雨滴" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=10}"
                             Command="{Binding SetEffectCommand}" CommandParameter="10" />
            <ctrl:EffectChip Label="霓虹" Highlight="{StaticResource BrushAccentPrimary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=15}"
                             Command="{Binding SetEffectCommand}" CommandParameter="15" />
            <ctrl:EffectChip Label="跑马灯" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=9}"
                             Command="{Binding SetEffectCommand}" CommandParameter="9" />
            <ctrl:EffectChip Label="极光" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=14}"
                             Command="{Binding SetEffectCommand}" CommandParameter="14" />
            <ctrl:EffectChip Label="音乐联动" Highlight="{StaticResource BrushAccentWarn}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=34}"
                             Command="{Binding SetEffectCommand}" CommandParameter="34" />
            <ctrl:EffectChip Label="游戏联动" Highlight="{StaticResource BrushAccentWarn}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=21}"
                             Command="{Binding SetEffectCommand}" CommandParameter="21" />
            <ctrl:EffectChip Label="火花" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=17}"
                             Command="{Binding SetEffectCommand}" CommandParameter="17" />
            <ctrl:EffectChip Label="闪烁" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=18}"
                             Command="{Binding SetEffectCommand}" CommandParameter="18" />
            <ctrl:EffectChip Label="混合" Highlight="{StaticResource BrushAccentSecondary}"
                             IsActive="{Binding Effect, Converter={StaticResource IntEq}, ConverterParameter=19}"
                             Command="{Binding SetEffectCommand}" CommandParameter="19" />
        </WrapPanel>

        <TextBlock Text="参数" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="速度" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Speed, StringFormat='{}{0}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="1" Maximum="10"
                            Value="{Binding Speed, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="快" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="慢" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="亮度" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Brightness, StringFormat='{}{0}'}"
                                   FontSize="14" FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Grid>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="4"
                            Value="{Binding Brightness, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="关" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="最亮" FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="颜色" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource GlassCard}" Padding="16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="基色" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" />
                <Border Width="32" Height="32" CornerRadius="16" Margin="16,0,12,0"
                        Background="{StaticResource BrushAccentPrimary}">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentPrimary}" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
                    </Border.Effect>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="R" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ColorR, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,8,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                    <TextBlock Text="G" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ColorG, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,8,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                    <TextBlock Text="B" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ColorB, UpdateSourceTrigger=LostFocus}" Width="48" Margin="4,0,0,0" FontSize="12"
                             Foreground="{StaticResource BrushTextPrimary}"
                             CaretBrush="{StaticResource BrushAccentPrimary}"
                             Background="{StaticResource BrushBgTertiary}" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,16,0,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="灯条 (Lightbar)" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="机身灯条独立控制" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LightbarEnabled, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
