<Window x:Class="CCU.Wpf.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="FadeInOut" AutoReverse="False">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="0.95" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0" BeginTime="0:0:1.2" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="16" Background="#E80D101A" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#80000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 模式图标 -->
            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                    Margin="16,0,0,0" VerticalAlignment="Center"
                    Background="{Binding AccentBrush}">
                <TextBlock x:Name="IconText" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 模式名称 + 副标题 -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ModeName" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock x:Name="ModeDesc" FontSize="13"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
